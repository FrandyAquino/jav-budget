{
  "expo": {
    "name": "Jav Budget",
    "slug": "jav-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/graphite.png",
    "scheme": "javbudget",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.frandyaquino.javbudget",
      "icon": "./assets/icons/graphite.png",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "buildNumber": "1",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherFinancialInfo",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "0A2A.1",
              "3B52.1",
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "85F4.1",
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.frandyaquino.javbudget",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0E1424"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/icon-dark.png"
    },
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#111214",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your personal finances."
        }
      ],
      "expo-notifications",
      "expo-status-bar",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Chalk",
            "ios": "./assets/icons/chalk.png",
            "android": {
              "foregroundImage": "./assets/icons/chalk-android.png",
              "backgroundColor": "#EEF2F8"
            }
          }
        ]
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "es"
          ]
        }
      ],
      "expo-background-task",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.frandyaquino.javbudget.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.frandyaquino.javbudget",
          "widgets": [
            {
              "name": "BudgetWidget",
              "displayName": "Monthly spending",
              "description": "This month's spending, budget left and net worth.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "src/features/widgets/budget-widget.tsx"
              }
            }
          ]
        }
      ],
      "expo-quick-actions",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to attach receipts.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to photograph receipts.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "@sentry/react-native/expo",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a417e416-8321-4a48-ae73-6815b7a84810"
    },
    "extra": {
      "eas": {
        "projectId": "a417e416-8321-4a48-ae73-6815b7a84810",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.frandyaquino.javbudget.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.frandyaquino.javbudget"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "frandyaquino"
  }
}
